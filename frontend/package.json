{
  "private": true,
  "name": "@thunderid/frontend",
  "version": "0.0.0",
  "description": "Frontend workspace for ⚡️ ThunderID",
  "author": "WSO2",
  "license": "Apache-2.0",
  "type": "module",
  "homepage": "https://github.com/thunder-id/thunderid/tree/main/frontend#readme",
  "bugs": {
    "url": "https://github.com/thunder-id/thunderid/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/thunder-id/thunderid"
  },
  "keywords": [
    "thunderid",
    "frontend",
    "workspace",
    "wso2"
  ],
  "scripts": {
    "build:apps": "nx run-many --target=build --projects=frontend/apps/*",
    "build:packages": "nx run-many --target=build --projects=frontend/packages/*",
    "clean": "pnpm clean:node_modules",
    "clean:node_modules": "rimraf node_modules",
    "dev": "nx run-many --target=dev --projects=frontend/apps/*",
    "test:packages": "nx run-many --target=test --projects=frontend/packages/*",
    "i18n:extract": "pnpm i18next-cli sync"
  },
  "pnpm": {
    "overrides": {
    "vite": "catalog:",
    "@asgardeo/i18n": "file:../../javascript/packages/i18n",
    "@asgardeo/browser": "file:../../javascript/packages/browser",
    "@asgardeo/javascript": "file:../../javascript/packages/javascript",
    "@asgardeo/react": "file:../../javascript/packages/react"
    }
    }
}
