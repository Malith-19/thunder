# ---------------------------------------------------------------------------
# Wayfinder Native sample - Backend-for-Frontend (BFF) configuration
#
# Every value here is read ONLY on the server (Next.js route handlers). None of
# it is exposed to the browser. The Flow Secret and client secret never leave
# the BFF.
# ---------------------------------------------------------------------------

# Base URL of the ThunderID backend.
THUNDERID_BASE_URL=https://localhost:8090

# The application id / client id of the confidential Flow-Secret client created
# by thunderid-config/thunderid-config.yaml. APP_ID is what /flow/execute expects
# as applicationId; CLIENT_ID is what /oauth2/token expects for token exchange.
# For this sample they are the same value.
THUNDERID_APP_ID=WAYFINDER-NATIVE
THUNDERID_CLIENT_ID=WAYFINDER-NATIVE

# Confidential OAuth client secret (token endpoint auth) and per-application Flow
# Secret (Flow Execution API). Both must match thunderid-config/thunderid.env.
THUNDERID_CLIENT_SECRET=wayfinder-native-client-secret
THUNDERID_FLOW_SECRET=wayfinder-native-flow-secret

# Space-separated scopes requested on the access token issued via token exchange.
THUNDERID_SCOPES=openid profile email booking:read booking:create booking:cancel

# Password used to encrypt the iron-session cookie. MUST be at least 32 chars.
# Generate one with: openssl rand -base64 32
SESSION_PASSWORD=change-me-to-a-random-string-at-least-32-chars

# ThunderID ships with a self-signed certificate in local development. Node
# rejects self-signed certs by default, so allow them for local dev only.
# NEVER set this to true in production.
THUNDERID_ALLOW_SELF_SIGNED=true
