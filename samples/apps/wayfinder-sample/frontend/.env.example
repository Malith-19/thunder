# Thunder OAuth client used for user sign-in in the Wayfinder web app.
# This is the WAYFINDER application — separate from the chat agent's client.
VITE_THUNDER_CLIENT_ID=WAYFINDER
VITE_THUNDER_BASE_URL=https://localhost:8090

# Set to "true" to enable the AI concierge chat widget and agent-related routes
# (/agent-callback, /signin-as-agent). When false (default), all AI features are
# hidden and the agent:access OAuth scope is not requested.
# The `thunderid wayfinder --ai` flag sets this automatically.
VITE_AI_FEATURES_ENABLED=true

# Application ID used for embedded /flow/execute calls. Defaults to VITE_THUNDER_CLIENT_ID.
VITE_THUNDER_APP_ID=wayfinder-app

# Set to "false" to use embedded app-native flows instead of the Login Gate redirect.
VITE_AUTH_IS_REDIRECT_BASED=true

# Only used when VITE_AUTH_IS_REDIRECT_BASED=false.
# "false" (default) uses the step-by-step custom UI. Verbose (SDK-orchestrated) mode is
# not currently supported in app-native mode — the SDK cannot send the Flow Secret header
# that app-native flow initiation requires, so this value is ignored when native.
VITE_AUTH_IS_VERBOSE=false

# --- App-native mode only (VITE_AUTH_IS_REDIRECT_BASED=false) ---
# App-native flows run against the dedicated confidential `wayfinder-native` app, which
# initiates flows with a Flow Secret and exchanges the assertion with its client secret.
# WARNING: shipping these secrets in a browser app is insecure and done here only because
# this is a local sample — never do this in a real single-page app.
VITE_THUNDER_NATIVE_APP_ID=wayfinder-native
VITE_THUNDER_NATIVE_CLIENT_ID=WAYFINDER-NATIVE
VITE_THUNDER_NATIVE_CLIENT_SECRET=wayfinder-native-client-secret
VITE_THUNDER_NATIVE_FLOW_SECRET=wayfinder-native-flow-secret
